{
  "name": "@wannanbigpig/dsh-usage-stats",
  "description": "DeepSeek 官方余额、Token 用量、月历热图与离线 tokenizer，内置在 Harness 侧栏",
  "version": "0.6.5",
  "icon": "docs/assets/logo.png",
  "homepage": "https://github.com/wannanbigpig/dsh-usage-stats#readme",
  "bugs": {
    "url": "https://github.com/wannanbigpig/dsh-usage-stats/issues"
  },
  "author": "wannanbigpig <wannanbigpig@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannanbigpig/dsh-usage-stats.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "balance",
    "usage-stats"
  ],
  "files": [
    "lib/",
    "docs/assets/screenshots/",
    "docs/assets/logo.png",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./usage": "./lib/usage.js",
    "./balance": "./lib/balance.js",
    "./providers": "./lib/providers.js",
    "./pricing": "./lib/pricing.js",
    "./ledger": "./lib/ledger.js",
    "./migration": "./lib/migration.js",
    "./rebuild": "./lib/rebuild.js",
    "./rpc": "./lib/rpc.js",
    "./settings": "./lib/settings.js",
    "./storage": "./lib/storage.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-all.mjs && node scripts/check-client-css.mjs",
    "check:client-css": "node scripts/check-client-css.mjs",
    "test": "npm run check && node scripts/test-all.mjs",
    "test:usage": "node scripts/test-usage.mjs",
    "test:tokenizer": "node scripts/test-tokenizer.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:storage-json": "DSH_REQUIRE_JSON_INTEGRATION=1 node scripts/test-storage-json-integration.mjs",
    "test:providers": "node scripts/test-providers.mjs",
    "test:recovery": "node scripts/test-rebuild-legacy.mjs",
    "test:client": "node scripts/smoke-client.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check:site": "node scripts/check-site.mjs",
    "build:site": "node scripts/build-site.mjs",
    "tokens": "node scripts/count-tokens.mjs",
    "whoami": "npm whoami --registry=https://registry.npmjs.org",
    "publish:public": "npm publish --registry=https://registry.npmjs.org",
    "test:host-current": "node scripts/test-host-current.mjs"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.1.6-0 || 0.1.6-alpha.1 || >=0.1.7-rc.2 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@huggingface/tokenizers": "^0.1.3",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.8.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2 || >=0.1.5-rc.1 <0.1.6-0 || 0.1.6-alpha.1 || >=0.1.7-rc.2 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.2 || >=0.1.5-rc.1 <0.1.6-0 || 0.1.6-alpha.1 || >=0.1.7-rc.2 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.1.5-rc.1 <0.1.6-0 || 0.1.6-alpha.1 || >=0.1.7-rc.2 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0 || 0.1.6-alpha.1 || >=0.1.7-rc.2 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
